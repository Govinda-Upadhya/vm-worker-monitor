{
  "name": "my-bun-app",
  "private": true,
  "packageManager": "bun@1.4.2",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "composer:deploy": "prisma deploy",
    "composer:dev": "prisma dev",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "deploy": "bun run build && bun run composer:deploy",
    "dev": "tsx watch src/index.ts",
    "dev:composer": "bun run build && bun run composer:dev",
    "migrate": "prisma db migrate",
    "migration:plan": "prisma migration plan",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "@prisma/composer": "0.35.0",
    "@prisma/composer-prisma-cloud": "0.35.0",
    "@prisma/orm-postgres": "8.0.0-rc.20",
    "@types/express": "^5.0.6",
    "alchemy": "2.0.0-beta.83",
    "express": "^5.3.0",
    "temporal-polyfill": "^1.0.6"
  },
  "devDependencies": {
    "@prisma/dev": "0.25.2",
    "@types/node": "^26.6.5",
    "prisma": "8.0.0-rc.28",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "effect": "4.0.3",
    "@effect/platform-bun": "4.0.3",
    "@effect/platform-node": "4.0.3",
    "@effect/platform-node-shared": "4.0.3",
    "@effect/sql-d1": "4.0.3",
    "@effect/sql-sqlite-do": "4.0.3",
    "@effect/vitest": "4.0.3"
  }
}
